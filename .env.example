# --- App ---
MAX_BULK_ROWS=5000
DEFAULT_SENDER=

# --- Database ---
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
SQLITE_PATH=./data/app.db

# --- SMS API ---
SMS_API_URL=https://api.lleida.net/sms/v2/
SMS_API_USER=
SMS_API_PASSWORD=

# --- Customer / loan API ---
CUSTOMER_API_BASE_URL=
# Optional per-campaign endpoints (absolute URLs or paths relative to the base URL)
CUSTOMER_API_ELIGIBLE_URL=
CUSTOMER_API_LOAN_ENDING_URL=
CUSTOMER_API_DELINQUENT_URL=
CUSTOMER_API_TOKEN=
CUSTOMER_API_KEY=
CUSTOMER_API_KEY_HEADER=X-API-Key
# CUSTOMER_API_HEADERS_JSON={"X-Tenant":"fihogar"}

# --- Automated campaigns (safe default: off) ---
AUTO_SMS_ENABLED=false
AUTOMATION_TIMEZONE=America/Santo_Domingo
AUTOMATION_HOUR=9
AUTOMATION_USERNAME=admin
LOAN_ENDING_DAYS=30
DELINQUENT_MIN_DAYS=1
# LOAN_ENDING_SMS_TEMPLATE=Hola {name}, tu préstamo está próximo a finalizar...
# DELINQUENT_SMS_TEMPLATE=Hola {name}, tienes un pago pendiente...

# --- Optional: seed users (only if DB has no users) ---
# SEED_USERS_JSON=[{"username":"admin","password":"ChangeMeNow!","department":"Admin","role":"admin"}]
